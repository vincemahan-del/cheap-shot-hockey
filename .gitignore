# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
scripts/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP server config (personal, not shared)
.mcp.json

# mabl CLI local debug artifacts (DOM/HAR/screenshots from `mabl ... debug`) — never commit
.mabl/

# recovery-agent runtime output (created in CI, not committed)
recovery-result.json
/scripts/recovery-agent/logs/

# eval runner tmp output (created at runtime, not committed)
/evals/recovery-agent/tmp/

# orchestrator plan-mode intent.json (runtime metadata, not committed)
/intent.json

# Claude Code local settings (personal overrides — do not commit)
.claude/settings.local.json

# shift-left coverage engine: live mabl pull (transient, regenerated by coverage-auditor)
/scripts/shift-left/.raw/
